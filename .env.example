FINVIZ_API_TOKEN=your-elite-api-token-here
FIN_NEWS_API_TOKEN=change-me-for-api-demo

# Optional dashboard social source.
# Current source: Stocktwits web/gateway data via curl impersonation.
SOCIAL_SOURCE=stocktwits
SOCIAL_PROXY_URL=
SOCIAL_REDDIT_SUBREDDITS=wallstreetbets,stocks,StockMarket,pennystocks
SOCIAL_USE_CURL_IMPERSONATE=1
SOCIAL_CURL_IMPERSONATE_PROFILE=chrome124
SOCIAL_MIN_INTERVAL_SEC=2
SOCIAL_TIMEOUT_SEC=20
SOCIAL_REDDIT_MAX_SUBREDDITS=1
SOCIAL_LIVE_TICKER_LIMIT=5
SOCIAL_MAX_ITEMS_PER_TICKER=100
SOCIAL_ALLOW_SAMPLE=0

# Legacy/diagnostic only - public Stocktwits API is disabled by default.
# Set STOCKTWITS_USE_PUBLIC_API=1 only if you intentionally want to test it.
STOCKTWITS_ACCESS_TOKEN=
STOCKTWITS_USE_PUBLIC_API=0

# Use curl-impersonate style requests first (recommended for Cloudflare/WAF checks).
STOCKTWITS_USE_CURL_IMPERSONATE=1
STOCKTWITS_CURL_IMPERSONATE_PROFILE=chrome124

# Optional - force stocktwits.com/symbol page parsing only.
STOCKTWITS_USE_WEB=0

# Optional - legacy public API fallback setting.
STOCKTWITS_WEB_FALLBACK=0

# Seconds between Stocktwits HTTP calls (default 5)
STOCKTWITS_MIN_INTERVAL_SEC=5

# Live web/gateway calls per dashboard refresh.
STOCKTWITS_LIVE_TICKER_LIMIT=5

# Optional - use bundled sample posts when live web parsing is blocked (default off)
STOCKTWITS_ALLOW_SAMPLE=0

# Optional - Week 5 MongoDB storage
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=fin_news_sentiment
