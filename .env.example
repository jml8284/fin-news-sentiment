# Copy to .env and paste the professor Finviz Elite API token.
#
# Setup (professor shared account):
#   1. Log in at https://elite.finviz.com with the course Finviz account
#   2. Open Settings -> API -> copy the token shown under "Add Authentication"
#   3. Paste below (do NOT put the login password in this file)
#
# Never commit .env to GitHub.

FINVIZ_API_TOKEN=your-elite-api-token-here

# Optional — dashboard social source (does not call Stocktwits by default).
# Current source: Bluesky public search via api.bsky.app.
SOCIAL_SOURCE=bluesky
SOCIAL_PROXY_URL=
SOCIAL_REDDIT_SUBREDDITS=wallstreetbets,stocks,StockMarket,pennystocks
SOCIAL_USE_CURL_IMPERSONATE=1
SOCIAL_CURL_IMPERSONATE_PROFILE=chrome124
SOCIAL_MIN_INTERVAL_SEC=2
SOCIAL_TIMEOUT_SEC=4
SOCIAL_REDDIT_MAX_SUBREDDITS=1
SOCIAL_LIVE_TICKER_LIMIT=5
SOCIAL_ALLOW_SAMPLE=1

# Legacy/diagnostic only — Stocktwits OAuth access token (if public API is blocked on your network)
# Register at https://api.stocktwits.com/developers/apps — streams/symbol may need Partner access.
STOCKTWITS_ACCESS_TOKEN=

# Use curl-impersonate style requests first (recommended for Cloudflare/WAF checks).
STOCKTWITS_USE_CURL_IMPERSONATE=1
STOCKTWITS_CURL_IMPERSONATE_PROFILE=chrome124

# Optional — skip blocked API and scrape stocktwits.com/symbol pages only (off by default; slow)
STOCKTWITS_USE_WEB=0

# Optional — allow HTML page scrape when API fails (off by default; professor asked to slow down)
STOCKTWITS_WEB_FALLBACK=0

# Seconds between Stocktwits HTTP calls (default 5)
STOCKTWITS_MIN_INTERVAL_SEC=5

# Live API calls per dashboard refresh; remaining tickers use bundled sample (default 5)
STOCKTWITS_LIVE_TICKER_LIMIT=5

# Optional — use bundled sample posts when live API/web are blocked (default on)
STOCKTWITS_ALLOW_SAMPLE=1

# Optional — Week 5 MongoDB storage
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=fin_news_sentiment
